<tagLabel tag="holding nothing" label="holding nothing"/>
<tagLabel tag="working" label="working"/>
<tagLabel tag="ennemy" label="ennemy"/>
<tagLabel tag="fallen" label="fallen"/>


<signDescription sign="A1">
+s-A1+l has various values : it's used as determinative for people,+s!
+land as ideogram for the =i suffix pronoun.+s!
+lit has many variants in both uses+s!
+bbibliography+s!
?800-+lsee any grammar+l
</signDescription>

<hasTag sign="A1" tag="seated"/>
<hasTag sign="A1" tag="holding nothing"/>

<!-- Sign values -->
<hasTransliteration sign="A1" transliteration="i" type="ideogram"/>

<signDescription sign="A2">
