<?xml version="1.0" encoding="iso-8859-1"?>
<!--
        XML encoding for hieroglyphic texts.
        In later versions, this encoding will be split into multiple layers.

        MDCDOC.DTD 

        Version 0.2

        ven dec 24 12:33:41 CET 2004

	This file documents and implements a possible DTD (Document Type Definition)
	for hieroglyphic texts.

	The main goal of this DTD is to propose a standard that should replace the old MdC.
	Conversion tool should be proposed, FROM the de-facto
        standards (winglyph, MacScribe, and of course :-) tksesh and
        sesh), and possibly TO them (but with probably some losses).

        Note that this would be mainly an EXCHANGE standard. It's perfectly ok to keep
        software-dependent format for internal use.

	We aim at :
	* generality : the DTD should cover as many cases as possible.
	* simplicity : the DTD should be easy to understand and to use.
	* extensibility : future needs should be possible to plug in the standard.
	* possibility to translate texts to and from the manuel de codage,
	  with reasonable loss of information.

	Clearly, the code will NOT be hand-written. The MdC (or a simple version of it)
	is well suited for this.

	Current status of this file:
		This file is a base document for discussions about the new standard.

        A note on generality:

        It is important to provide a standard for representing
        drawings, to encode whole scenes, and to allow one some control over
        presentation. This is an important issue for documents whose ultimate goal is paper
        publishing. Now, it's also important to allow logical presentation, and in particular,
        multiple paginations.

        One more note :
        I don't thing, on the other hand, that this is the place to encode parallels and the like.
        parallel should be treated as REFERENCES to texts.

        TO DO:

        -       Discuss what's here.
        -	Add the philological glosses signs like [], {}, etc...
        -	Add more stuff about text position and the like.
-->

<!-- First, let's introduce entities : -->

<!--	basicglyph

        An entity which represent all glyphs
-->

<!ENTITY % basicglyph "hieroglyph | ligature | cadrat| cartouche | plaintext">

<!-- 
	The identifiers which follow are Toggles.
        
	Question : for some of these, would it not be better to include them in the signs themselves ?
	I think mostly of RedOn and BlackOn.

        NO TOGGLES !

<!ENTITY % SEP "hatchOn | hatchOff | RedOn | BlackOn | LACUNA | LINELACUNA">
-->


<!-- 
        Here are attributes common to most elements
-->

<!ENTITY % att.com 
        "       id	ID	#IMPLIED
                xml:lang  NMTOKEN  #IMPLIED"
>
<!--                    Plaintext Attributes                       
                        Attributes for the plain text
                        element. Redefinition of these will allow
                        extension                                  
-->

<!ENTITY % plaintext.att "">

<!--                    hieroglyph Attributes                       
                        Attributes for hieroglyphs
                        element. Redefinition of these will allow
                        extension                                  -->

<!ENTITY % hieroglyph.att "">

<!--                    Legal ways of describing a sign's drawing  -->

<!ENTITY % drawing.ent "#PCDATA"                                      >

<!-- Now, let's start serious things -->

<!--    mdcdoc:
        
        A document. It represent an egyptian document, with both iconography and
        text.
        
-->

<!ELEMENT mdcdoc  (mdcprolog?, (mdctext|mdcdraw|mdcplate))*>

<!ATTLIST  mdcdoc
        %att.com;
>

<!--    mdcprolog:

        will be used to define general utilitary stuff for the
	document : author, name and title of the document (multiple
	titles in multiple languages should be possible), description of ligatures, maybe 
	new sign descriptions, and so on.

        idea : new signs may be defined in the prolog. But the prolog may reference a list
        of sign definition files, which would contain enough information to define signs.
        Then, a particular sign would be searched first in these files, and then only in the standard
        font.
-->

<!ELEMENT mdcprolog  ((mdctitle)*, signdef*)>


<!ATTLIST  mdcprolog
        %att.com;
>

<!--                    definition of a sign                       -->

<!ELEMENT  signdef      (%drawing.ent;)>
<!--         dimx       width
             dimy       height. Unit is "natural size of G1 sign" -->
        
<!ATTLIST  signdef
             dimx       CDATA                              #REQUIRED
             dimy       CDATA                              #REQUIRED  >

<!--                    ligdef : definition of a ligature          -->
<!--                    Ligatures are normally the same for all
                        texts. This provides a way to propose a
                        specific description for a ligature.       -->

<!ELEMENT  ligdef       (signpos+)>
<!--         x          position                                   -->
<!ATTLIST  ligdef
             dimx       CDATA                              #IMPLIED  
             dimy       CDATA                              #IMPLIED  
>

<!--                    signpos                                    -->
<!--                    Sign in a ligature                         -->
<!--                    x,y : position from bottom-left corner, in "natural size of G1" units -->
<!--                    size : size relative to normal size ???? -->
<!--			       here, an absolute size (relative to G1) might be useful -->

<!ELEMENT  signpos      EMPTY                                            >
<!ATTLIST  signpos
             x          CDATA                              #REQUIRED
             y          CDATA                              #REQUIRED
             size	CDATA			           #REQUIRED
>

        
<!--	mcdplate:

        Not all document are organised in plates
        mdcplates are used for fac-simile-like texts
        or, in general, texts for which disposition is important.

        Attributes :

	label ID #IMPLIED  identifier for references to the plate. 
	dimx CDATA #IMPLIED  width of the plate, in mm 
	dimy CDATA #IMPLIED  heigh of the plate, in mm 
-->

<!ELEMENT mdcplate  (mdctitle*, (mdctext|mdcdraw|mdcregister)*)>

<!ATTLIST mdcplate
        format CDATA #IMPLIED
	label CDATA #IMPLIED
	dimx CDATA #IMPLIED
	dimy CDATA #IMPLIED
        %att.com;
>

<!--    mdctitle:

        Title for various elements. It might be important as a multilingual reference.
        People will be able to search for the Eloquent Peasant,
        l'Oasien, le Paysan &Eacute;loquent, etc.
-->

<!ELEMENT mdctitle  (#PCDATA)>

<!ATTLIST mdctitle
        %att.com;
>

<!ELEMENT hatchOn EMPTY>
<!ATTLIST  hatchOn
        %att.com;        
>

<!ELEMENT hatchOff EMPTY>
<!ATTLIST  hatchOff
        %att.com;
>

<!ELEMENT RedOn EMPTY>
<!ATTLIST  RedOn
        %att.com;
>

<!ELEMENT RedOff EMPTY>
<!ATTLIST  RedOff
        %att.com;
>

<!ELEMENT mdcregister (mdctext|mdcdraw|mcdregister)*>

<!--	mdctext

        A hieroglyphic text.

        Attributes
        
       	orient : orientation of the text. lr/rl means left-to-right and right-to-left.
        signorient : default sign orientation. For texts which make heavy use
        	of retrograde writing.
        layout: layout of the text, in lines or in columns.
	label CDATA #IMPLIED
	posx CDATA #IMPLIED
	posy CDATA #IMPLIED
-->

<!ELEMENT mdctext   (%basicglyph;|%SEP;| textsuper)*>

<!ATTLIST mdctext
	orient (lr | rl) "rl"
        signorient (normal | reversed) "normal"
        layout (lines|columns) "lines"
	label CDATA #IMPLIED
	posx CDATA #IMPLIED
	posy CDATA #IMPLIED
        %att.com;
>

<!--	textsuper
        Text in superscript over a "|"
-->

<!ELEMENT textsuper  (#PCDATA)>
<!ATTLIST  textsuper
        %att.com;
>

<!--    cadrat

        Attributes:
        
        The following attributes mean that the cadrat is hatched.
        It can be used for ANY cadrat, including an internal one.

	hatch1  (y|n) n : top first quarter cadrat 
	hatch2  (y|n) n : top second quarter cadrat 
	hatch3  (y|n) n : bottom first quarter cadrat 
	hatch4  (y|n) n : bottom second quarter cadrat
-->

<!ELEMENT cadrat  (hcadrat)*>

<!ATTLIST cadrat 
	hatch1  (y|n) "n" 
	hatch2  (y|n) "n"
	hatch3  (y|n) "n"
	hatch4  (y|n) "n"
        %att.com;
>

<!--    hcadrat

        horizontal line of signs 

-->

<!ELEMENT hcadrat  (%basicglyph;)*>
<!ATTLIST  hcadrat
        %att.com;
>

<!--	lig
        ligatured signs. Similar to Winglyph &.
-->

<!ELEMENT lig  (hieroglyph)*>
<!ATTLIST  lig
        %att.com;
>

<!--	hieroglyph
        A hieroglyph.
        The data is the code of the hieroglyph.

	Attributes:
        drawing : reference to a drawing of the sign. Either for non-standard 
                  drawings, or for signs peculiar to a text.
	href  CDATA #IMPLIED  an url for a drawing or a discussion of the sign 
        size CDATA #IMPLIED  size relative to "normal size" 
        rot CDATA 0  rotation of the size, in degree. Trigonometric sense ? 
        reversed :  is the sign reversed according to MAIN orientation ? 
        xfill : should the sign grow to fill the horizontal space available to him
        	(for hieratic texts, in particular Ramessides)
        yfill : same for vertical spaces.
-->

<!ELEMENT hieroglyph  (#PCDATA)>
<!ATTLIST hieroglyph 
        descr CDATA #IMPLIED
        href  CDATA #IMPLIED
        drawing IDREF #IMPLIED
        gramend (y|n) "n"
        wordend (y|n) "n"
        size CDATA #IMPLIED
        rot CDATA "0"
        reversed (y|n) "n"
        xfill (y|n) "n"
        yfill (y|n) "n"
        %att.com;
	%hieroglyph.att;
>

<!-- drawnhiero

     An unkown or not yet supported sign. Should perhaps be moved to
the prolog part.
--> 

<!ELEMENT drawnhiero (mdcdraw)>
<!ATTLIST  drawnhiero
        %att.com;
>

<!--    plaintext
        
        Non-hieroglyphic text.
        
        Extension will redefine plaintext.
-->
       

<!ELEMENT plaintext (#PCDATA)*>
<!ATTLIST plaintext
        FONT CDATA "latin"
        %att.com;
        %plaintext.att;
>

<!--	cartouche
        
        Cartouche-like construct

        Attributes :

        kind	: kind of construct
        begin	: see winglyph for an explanation 
        end	: id.
        middle	: if "y", then the middle bars are drawn. if "n", they are not drawn.
-->

<!ELEMENT cartouche (hieroglyph|cadrat|%SEP;|plaintext)*>

<!ATTLIST cartouche
        kind	(cartouche|serekh|hwt|inb|empty) "cartouche"
        begin	(up|down|none) "up"
        end	(up|down|none) "down"
        middle	(y|n) "y"
        %att.com;
>
<!--
	The format for describing drawings should be discussed.

        Existing formats are probably too complex.  We only need a subset of them.
        
        Anyway, the scene description language should be graphically rather simple,
        but also include high level operators (probably not at the same level)
        It would be nice to be able to say :
        <draw>
        	<unicogroup id="003">
                        <topic>
                                <unico code="A30" id="001" descr="owner offering flowers">
                                here the drawing (optional ?)
                		</unico>
                        </topic>
        		<unico code="M2" id="002"/>
			<action type="hold" subj="001" obj="002"/>
                </unicogroup>
		<mdctext speaker="003" posx=....>
                        ... hieroglyphic text ...
                </mdctext>
        <mdcdraw/>
        
        The encoding which was used for Karnak Talatat would be an
        interesting starting point.

        I'm not saying we should propose a complete system for scene representation right
        now, but that the system used for scene should be extensible. 
-->

<!ELEMENT mdcdraw  (#PCDATA)>
<!ATTLIST  mdcdraw
        %att.com;
>

<!--                    note about something in the text           -->
<!--                    to be defined                              -->
<!ELEMENT  note         EMPTY                                        >
<!--         
             xml:link   states that this element is an extended link
             inline     true : states that this element is the source
                        of the link.
                        if it is 'false', then the link links two
		        entities. this allows one to build links
                        between two completely independant data sources.
                                                                   -->
<!ATTLIST  note_1
             xml:link   CDATA                      #FIXED 'extended'
             inline     (true|false)                         'true'      
>
