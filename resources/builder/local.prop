# If you want a particular destination directory for the application, uncomment
# DESTDIR (and modify if necessary) 
#DESTDIR=/usr/local
#DESTDIR=/Applications
#DESTDIR=/where/you/want

# The directory where the IzPack installer builder is installed
#IZPACK=/home/rosmord/IzPack
IZPACK=/home/rosmord/Prog/BibliothequesJava/IzPack_3_8_1

# The path for the mac application bundler 
JARBUNDLER=/home/rosmord/Prog/BibliothequesJava/jarbundler-1.4.jar

# The argument for using the netbeans profiler
PROFILING_ARGS=-agentpath:/usr/local/netbeans-5.0/profiler1/lib/deployed/jdk15/linux/libprofilerinterface.so=/usr/local/netbeans-5.0/profiler1/lib,5140

###################################################################
# Properties used for building the documentation

# Uncomment to build documentation.
GENERATE_DOC=true

# CLASSPATH TO THE SAXON XSL ENGINE (for doc. generation)

PATH_TO_SAXON=/usr/share/java/saxon-6.5.4.jar

# docbook 4.4 dtd
DOCBOOK_DTD=/usr/share/xml/docbook/schema/dtd/4.4/docbookx.dtd
# script for generating the html documentation
WEB_XSL=/usr/share/xml/docbook/stylesheet/nwalsh/html/chunk.xsl

FO_XSL=/usr/share/xml/docbook/stylesheet/nwalsh/fo/docbook.xsl
#FO_XSL=/usr/share/xml/docbook/stylesheet/nwalsh/fo/fo.xsl
FOP_DIR=/home/rosmord/Prog/BibliothequesJava/fop-0.20.5
